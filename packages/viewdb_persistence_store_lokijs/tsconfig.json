{
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "rootDir": ".",
    "ignoreDeprecations": "6.0",
    "strict": false,
    "types": ["node", "lokijs", "vitest/globals"]
  },
  "include": ["src", "__tests__"],
  "exclude": ["node_modules", "dist"]
}
