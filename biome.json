{
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noConstructorReturn": "off",
        "noUnusedVariables": "off",
        "noUnusedImports": "off"
      },
      "suspicious": {
        "noShadowRestrictedNames": "off",
        "noPrototypeBuiltins": "off",
        "noConfusingVoidType": "off",
        "noImplicitAnyLet": "off",
        "noExplicitAny": "off"
      },
      "complexity": {
        "noUselessConstructor": "off",
        "useOptionalChain": "off",
        "noUselessThisAlias": "off",
        "useArrowFunction": "off",
        "noUselessTernary": "off",
        "noUselessRename": "off",
        "useLiteralKeys": "off",
        "noBannedTypes": "off",
        "noArguments": "off",
        "useDateNow": "off"
      },
      "style": {
        "useNodejsImportProtocol": "off",
        "noNonNullAssertion": "off",
        "useImportType": "off",
        "useTemplate": "off",
        "useConst": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "es5"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "files": {
    "includes": ["**", "!**/dist", "!**/coverage", "!**/node_modules", "!**/.turbo"]
  }
}
